// Cloudflare Worker serving the Vite build (dist/) as static assets.
// Workers Builds runs the tests and build, then `npx wrangler@4 deploy`, on every push to main.
{
  "name": "pg-tiny-town-merge",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
